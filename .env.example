# ===========================================
# MultiLingual Assistive Device (MAD) - Env
# ===========================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Then export them before running:
#   source .env
# ===========================================

# Google Cloud Text-to-Speech API key
# Get one at: https://console.cloud.google.com/apis/credentials
export GOOGLE_TTS_API_KEY="your_text_to_speech_api_key_here"

# Google Cloud Translation API key
export GOOGLE_TRANSLATE_API_KEY="your_translate_api_key_here"

# Google Cloud Speech-to-Text API key
export GOOGLE_STT_API_KEY="your_speech_to_text_api_key_here"
